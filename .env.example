# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/calendar

# Optional — server
DATABASE_MAX_CONNECTIONS=16
BIND_ADDR=127.0.0.1:8080
SESSION_TTL_HOURS=168

# Optional — enables TOTP secret / notification-provider credential encryption.
# 32 bytes as 64 hex chars, or base64. Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Optional — enables WebAuthn/passkey login. Both must be set together.
WEBAUTHN_RP_ID=calendar.example.com
WEBAUTHN_ORIGIN=https://calendar.example.com

# Optional — attachment size cap in bytes (default 50 MB) and soft-delete
# retention before purge, in days (default 30).
ATTACHMENT_MAX_BYTES=52428800
RETENTION_DAYS=30

# Required for inbound iMIP RSVPs — Postmark must send this secret back on
# inbound webhook calls; the endpoint fails closed (403) while it is unset.
POSTMARK_INBOUND_SECRET=

# Optional — Google Places API (New) key; enables place autocomplete in the
# web UI event form (server-side proxy). Enable "Places API (New)" on the key.
GOOGLE_MAPS_API_KEY=

# Optional — docker-compose only: host port to publish the app on (default 8080).
APP_PORT=8080
